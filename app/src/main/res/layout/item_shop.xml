<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/bg_cat_card"
    android:padding="14dp"
    android:layout_marginBottom="10dp">

    <TextView android:id="@+id/itemName" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textColor="@color/text" android:textSize="14sp" android:textStyle="bold"/>
    <TextView android:id="@+id/itemPrice" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/gold" android:textSize="12sp" android:layout_marginEnd="10dp"/>
    <Button android:id="@+id/itemBtn" android:layout_width="wrap_content" android:layout_height="40dp" android:background="@drawable/bg_btn_success" android:textColor="#FFFFFF" android:textSize="12sp" android:stateListAnimator="@null"/>
</LinearLayout>