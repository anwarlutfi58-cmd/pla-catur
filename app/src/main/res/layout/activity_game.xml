<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_dark"
    android:padding="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingVertical="4dp">

        <Button android:id="@+id/btnHome" android:layout_width="wrap_content" android:layout_height="44dp" android:background="@drawable/bg_panel" android:text="@string/home" android:textColor="@color/text" android:textSize="13sp" android:stateListAnimator="@null"/>
        <TextView android:id="@+id/txtTurn" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:textColor="@color/accent" android:textSize="16sp" android:textStyle="bold"/>
        <TextView android:id="@+id/txtStatus" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/bg_panel" android:paddingHorizontal="10dp" android:paddingVertical="8dp" android:textColor="@color/danger" android:textSize="12sp" android:textStyle="bold" android:visibility="gone"/>
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="6dp">

        <com.pla.catur.ChessBoardView
            android:id="@+id/boardView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </FrameLayout>

    <TextView
        android:id="@+id/txtInfo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_panel"
        android:gravity="center"
        android:minHeight="36dp"
        android:paddingHorizontal="10dp"
        android:paddingVertical="6dp"
        android:textColor="@color/text"
        android:textSize="12sp"/>
</LinearLayout>